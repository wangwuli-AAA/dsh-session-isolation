{
  "name": "@local/dsh-session-isolation",
  "version": "1.2.0",
  "private": true,
  "description": "Host + browser bundle: give every new session in a configured workspace its own working directory, plus a header button that opens that directory and a client-side repair for file addresses that DSH builds with a stale workspace root.",
  "license": "MIT",
  "author": "wangwuli-AAA",
  "homepage": "https://github.com/wangwuli-AAA/dsh-session-isolation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangwuli-AAA/dsh-session-isolation.git"
  },
  "bugs": {
    "url": "https://github.com/wangwuli-AAA/dsh-session-isolation/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "session",
    "workspace",
    "isolation",
    "cordis"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
